# ============================================================================
# Jail Ki Chai - frontend environment (Vite). Only VITE_* vars reach the browser.
# These are PUBLIC values - never put private keys here.
# ============================================================================

# ---- API / realtime --------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# ---- ImageKit (public values only) -----------------------------------------
VITE_IMAGEKIT_URL_ENDPOINT=
VITE_IMAGEKIT_PUBLIC_KEY=

# ---- Razorpay (key id only, never the secret) ------------------------------
VITE_RAZORPAY_KEY_ID=

# ---- Branding --------------------------------------------------------------
VITE_APP_NAME=Jail Ki Chai
