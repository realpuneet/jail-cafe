# ============================================================================
# Jail Ki Chai - backend environment. Copy to .env. NEVER commit real secrets.
# Validated with Zod at boot (src/config/env.js); the app exits if invalid.
# ============================================================================

# ---- App -------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# HTTP port the API listens on
PORT=5000
# Base path for versioned API routes
API_PREFIX=/api/v1
# Comma-separated CORS allowlist (exact origins, no trailing slash)
CLIENT_URLS=http://localhost:5173
# Number of reverse proxies in front of the API (needed for correct client IP / secure cookies)
TRUST_PROXY=1
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Max JSON/urlencoded body size
BODY_LIMIT=100kb
# Optional: error tracking (Sentry-ready hook). Leave empty to disable.
SENTRY_DSN=
# Run background workers inside the API process. Set false to run them separately: npm run worker
RUN_WORKERS=true

# ---- MongoDB ---------------------------------------------------------------
# Must be a replica set (single-node is fine) - transactions are required for booking/payments.
# Local docker: mongodb://localhost:27017/?replicaSet=rs0   Atlas: mongodb+srv://...
MONGO_URI=
MONGO_DB_NAME=jailkichai
MONGO_MAX_POOL_SIZE=50
# primary | primaryPreferred | secondary | secondaryPreferred | nearest
# Use secondaryPreferred only for read-heavy, staleness-tolerant queries once replicas exist.
MONGO_READ_PREFERENCE=primary

# ---- Redis -----------------------------------------------------------------
# Cache, rate limit, OTP, queues (BullMQ), Socket.io adapter
REDIS_URL=
# Namespace prefix applied to every key we create
REDIS_KEY_PREFIX=jkc:

# ---- Auth ------------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Min 32 chars. Access and refresh secrets MUST differ.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
# Cookie domain for the refresh token (leave empty for localhost)
COOKIE_DOMAIN=
# lax | strict | none  (none requires HTTPS and is only for a cross-site API domain)
COOKIE_SAMESITE=lax
OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---- ImageKit --------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/jailkichai

# ---- Razorpay --------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# ---- Notifications ---------------------------------------------------------
# WhatsApp Cloud API messages endpoint, e.g. https://graph.facebook.com/v20.0/<PHONE_NUMBER_ID>/messages
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# MSG91 auth key + OTP flow template id (OTP SMS). Empty in dev = OTP is logged, never in production
SMS_API_KEY=
SMS_TEMPLATE_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Rate limit ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
# Requests per window per IP (global)
RATE_LIMIT_MAX=300
# Requests per window per IP on auth/OTP endpoints
AUTH_RATE_LIMIT_MAX=10

# ---- Seed (npm run seed) ---------------------------------------------------
SEED_ADMIN_EMAIL=admin@jailkichai.local
# Min 10 chars; required to create the admin user
SEED_ADMIN_PASSWORD=

# ---- Cafe business config --------------------------------------------------
CAFE_NAME=Jail Ki Chai
DEFAULT_DELIVERY_RADIUS_KM=7
# Parties the venue can host per day (the date is reserved when a customer accepts a quote)
PARTY_MAX_PER_DAY=2
# Cafe coordinates, used for distance-based delivery zones (leave empty to disable them)
CAFE_LAT=
CAFE_LNG=
# Minimum order value in RUPEES (the API itself works in paise)
MIN_ORDER_AMOUNT=100
